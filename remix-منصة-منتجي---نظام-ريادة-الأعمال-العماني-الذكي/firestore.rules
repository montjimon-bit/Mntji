rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Designated Admin Email
    function isAdmin() {
      return isSignedIn() && request.auth.token.email == "hudifamoosa2007@gmail.com";
    }

    // Users Collection
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();

      // User Wishlist Subcollection
      match /wishlist/{productId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }

      // User Custom Awni Folders Subcollection
      match /awniFolders/{folderId} {
        allow read, write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      }

      // User Saved Awni Conversations Subcollection
      match /awniConversations/{conversationId} {
        allow read, write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      }
    }

    // Products Collection (Public marketplace catalog)
    match /products/{productId} {
      allow read: if true;
      // Admin or authenticated sellers can create, update, delete products
      allow create, update, delete: if isSignedIn();

      // Product Reviews Subcollection
      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if incoming().rating >= 1 && incoming().rating <= 5 &&
                         incoming().comment is string && incoming().comment.size() <= 1000 &&
                         incoming().userName is string && incoming().userName.size() <= 100;
        allow update, delete: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      }
    }

    // Orders Collection
    match /orders/{orderId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // Project Ratings & Investor Evaluations Collection
    match /projectRatings/{ratingId} {
      allow read: if true;
      allow create: if incoming().rating >= 1 && incoming().rating <= 5 &&
                       incoming().projectId is string &&
                       incoming().evaluatorName is string &&
                       incoming().comment is string;
      allow update, delete: if isSignedIn();
    }
  }
}
